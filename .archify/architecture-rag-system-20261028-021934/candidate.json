  "cards": [
    {
      "dot": "cyan",
      "title": "Request path",
      "items": [
        "Browser posts to FastAPI /query; NeMo Guardrails gates off-topic and jailbreak input before any retrieval",
        "The LangGraph agent runs planner → retriever → grader → rewriter → responder on every question",
        "Synthesis goes through the Portkey gateway (cache, retry, fallback) to Groq models"
      ]
    },
    {
      "dot": "emerald",
      "title": "Hybrid retrieval",
      "items": [
        "Dense all-mpnet-base-v2 768-d and BM25 sparse vectors live on the same Qdrant points",
        "Both rankings are fused with Reciprocal Rank Fusion, then reranked by a local FlashRank cross-encoder",
        "Retrieval is bounded: 20 dense + 20 sparse → 15 fused → 5 reranked chunks"
      ]
    },
    {
      "dot": "violet",
      "title": "Knowledge base",
      "items": [
        "Ingestion is a separate offline pipeline: parsers → ~1500-char chunks → dense + BM25 → Qdrant upsert",
        "13 technical domains (databases, DSA, RAG, ML, MLOps, Kubernetes, Python APIs, frontend, backend) plus distractor material",
        "674 source documents and 1174 indexed points in the live rag-v1 collection"
      ]
    },
    {
      "dot": "amber",
      "title": "Quality & visibility",
      "items": [
        "RAGAS and DeepEval suites score faithfulness, relevancy, precision, recall and hallucination against thresholds.py",
        "CI runs 16 offline unit tests on every PR and gates on the eval suites where a backend is configured",
        "Every stage emits Logfire spans and LangSmith traces for per-answer inspection"
      ]
    }
  ]
