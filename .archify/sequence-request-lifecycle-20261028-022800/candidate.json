  "cards": [
    {
      "dot": "cyan",
      "title": "Cheap steps first",
      "items": [
        "Guardrails, planner, grader and rewriter all use the fast gpt-oss-20b model at temperature 0",
        "Retrieval is bounded at 20 dense + 20 sparse candidates, fused to 15 and reranked to 5 before any synthesis"
      ]
    },
    {
      "dot": "emerald",
      "title": "Where the quality comes from",
      "items": [
        "Hybrid dense + BM25 search is fused with Reciprocal Rank Fusion, so semantic and keyword matches both survive",
        "A local FlashRank cross-encoder re-scores the fused list before the grader judges usefulness",
        "Synthesis only ever sees passages the grader accepted"
      ]
    },
    {
      "dot": "amber",
      "title": "When retrieval fails",
      "items": [
        "An unreachable vector DB raises RetrievalUnavailableError instead of returning an empty list",
        "Grading and rewriting are skipped, and the answer states that retrieval was unavailable",
        "The API exposes retrieval_error so the UI shows 'Retrieval unavailable' rather than '0% confidence'"
      ]
    }
  ]
