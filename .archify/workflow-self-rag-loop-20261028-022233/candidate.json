  "cards": [
    {
      "dot": "cyan",
      "title": "How the loop stays corrective",
      "items": [
        "The grader reads each retrieved passage against the question and returns only the useful ones with a confidence score",
        "An irrelevant verdict routes to the rewriter, which reformulates the query and re-runs retrieval from scratch",
        "retry_count is bounded by MAX_RETRIEVAL_RETRIES (2), so the loop always terminates and the last context is still used",
        "Off-topic and jailbreak input is refused by the guardrail before any planner or retrieval work happens"
      ]
    },
    {
      "dot": "emerald",
      "title": "Two shortcuts that skip work",
      "items": [
        "Greetings and memory-only questions are answered from conversation history without touching the vector store (planner → responder)",
        "A vector-DB outage is disclosed to the user and skips rewriting entirely, because a new query cannot fix a dead socket",
        "An empty-but-healthy index is reported as no context found, so the two failures never look alike"
      ]
    },
    {
      "dot": "amber",
      "title": "What the user sees per answer",
      "items": [
        "Grader verdict chip (context verified or low relevance) with confidence percentage",
        "Rewrite count, end-to-end latency, the agent's plan steps and every retrieved chunk with its source document"
      ]
    }
  ]
